<div class="max-w-2xl mx-auto my-10 p-6 bg-white rounded-xl shadow border border-gray-100">
  <div class="flex items-center justify-between border-b pb-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-800"><%= @user.name %></h1>
      <p class="text-sm text-gray-500"><%= @user.email %></p>
    </div>
    <%= link_to "Şifre Değiştir", edit_password_path, class: "px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-sm font-medium transition" %>
  </div>

  <div class="space-y-4">
    <div>
      <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Hakkında / Biyografi</h3>
      <p class="text-gray-700 mt-1"><%= @user.bio.presence || "Henüz bir biyografi eklenmemiş." %></p>
    </div>

    <div>
      <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Kayıt Tarihi</h3>
      <p class="text-gray-700 mt-1"><%= @user.created_at.strftime("%d.%m.%Y") %></p>
    </div>
  </div>
</div>