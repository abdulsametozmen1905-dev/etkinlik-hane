<div class="max-w-3xl mx-auto p-6 bg-white rounded-xl shadow-sm border border-gray-200 mt-6">
<h1 class="text-2xl font-bold text-gray-900 mb-6">Kategori Yönetimi</h1>
<!-- Kategori Ekleme Formu -->
<%= form_with model: [:admin, @category], local: true, class: "mb-8 flex gap-3" do |f| %>
    <div class="flex-1">
    <%= f.text_field :name, placeholder: "Yeni kategori adı...", class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>
    <div>
    <%= f.submit "Kategori Ekle", class: "bg-indigo-600 text-white px-5 py-2 rounded text-sm font-medium hover:bg-indigo-700 cursor-pointer" %>
    </div>
<% end %>

<!-- Mevcut Kategoriler Listesi -->
<h2 class="text-lg font-bold text-gray-800 mb-4">Kategoriler</h2>
<div class="space-y-2">
    <% @categories.each do |cat| %>
    <div class="flex items-center justify-between p-3 bg-gray-50 rounded border border-gray-200">
        <span class="text-sm font-medium text-gray-800"><%= cat.name %></span>
        <div class="flex gap-2">
        <%= link_to "Düzenle", edit_admin_category_path(cat), class: "bg-yellow-500 text-white px-3 py-1 rounded text-xs font-medium hover:bg-yellow-600" %>
        <%= link_to "Sil", admin_category_path(cat), data: { turbo_method: :delete, turbo_confirm: "Bu kategoriyi silmek istediğinize emin misiniz?" }, class: "bg-red-600 text-white px-3 py-1 rounded text-xs font-medium hover:bg-red-700" %>
        </div>
    </div>
    <% end %>
</div>
</div>