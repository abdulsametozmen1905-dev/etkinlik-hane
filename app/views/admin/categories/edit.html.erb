<div class="max-w-md mx-auto p-6 bg-white rounded-xl shadow-sm border border-gray-200 mt-6">
<h1 class="text-2xl font-bold text-gray-900 mb-6">Kategoriyi Düzenle</h1>

<%= form_with model: [:admin, @category], local: true, class: "space-y-4" do |f| %>
    <div>
    <%= f.label :name, "Kategori Adı", class: "block text-xs font-semibold text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div class="flex items-center justify-between pt-2">
    <%= link_to "← Geri Dön", admin_categories_path, class: "text-indigo-600 hover:underline text-sm font-medium" %>
    <%= f.submit "Güncelle", class: "bg-indigo-600 text-white px-5 py-2 rounded text-sm font-medium hover:bg-indigo-700 cursor-pointer" %>
    </div>
<% end %>
</div>