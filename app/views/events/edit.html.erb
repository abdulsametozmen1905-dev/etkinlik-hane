<div class="max-w-xl mx-auto p-6 bg-white rounded-lg shadow-sm border border-gray-200 mt-6">
  <h1 class="text-2xl font-bold mb-6 text-gray-900">Etkinliği Düzenle</h1>

  <%= form_with model: @event, local: true do |f| %>
    <% if @event.errors.any? %>
      <div class="mb-4 p-3 bg-red-50 text-red-700 rounded text-sm">
        <ul>
          <% @event.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :title, "Etkinlik Başlığı", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :title, class: "w-full px-3 py-2 border rounded-md focus:ring focus:ring-indigo-200" %>
    </div>

    <div class="mb-4">
      <%= f.label :description, "Açıklama", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 4, class: "w-full px-3 py-2 border rounded-md focus:ring focus:ring-indigo-200" %>
    </div>

    <div class="mb-4">
      <%= f.label :category_id, "Kategori", class: "block text-xs font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :category_id, Category.all, :id, :name, { prompt: "Kategori Seçin" }, class: "w-full p-2.5 border border-gray-300 rounded-lg focus:outline-none focus:ring-1 focus:ring-indigo-500 text-xs bg-gray-50" %>
    </div>

    <div class="grid grid-cols-2 gap-4 mb-4">
      <div>
        <%= f.label :date_time, "Tarih ve Saat", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.datetime_local_field :date_time, class: "w-full px-3 py-2 border rounded-md focus:ring focus:ring-indigo-200" %>
      </div>
      <div>
        <%= f.label :quota, "Kontenjan", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :quota, class: "w-full px-3 py-2 border rounded-md focus:ring focus:ring-indigo-200" %>
      </div>
    </div>

    
    <div class="mb-4">
      <%= f.label :cover_image, "Kapak Görseli", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.file_field :cover_image, class: "w-full px-3 py-2 border rounded-md bg-white focus:ring focus:ring-indigo-200 text-sm" %>
    </div>

    <div class="mb-6">
      <%= f.label :location, "Konum", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :location, class: "w-full px-3 py-2 border rounded-md focus:ring focus:ring-indigo-200" %>
    </div>

    <div class="flex items-center gap-3 p-3 bg-gray-50 border border-gray-200 rounded-lg my-4">
    <%= f.check_box :published, class: "w-5 h-5 text-indigo-600 rounded border-gray-300 focus:ring-indigo-500 cursor-pointer" %>
    <%= f.label :published, "Bu etkinliği hemen yayınla", class: "text-sm font-medium text-gray-700 cursor-pointer" %>
  </div>

    <%= f.submit "Değişiklikleri Kaydet", class: "w-full bg-indigo-600 text-white py-2 rounded-md hover:bg-indigo-700 transition" %>
    <div class="flex items-center gap-3 p-3 bg-gray-50 border border-gray-200 rounded-lg my-4">
    </div>
  <% end %>
</div>