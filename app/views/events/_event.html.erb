<div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 flex flex-col justify-between hover:shadow-md transition">
    <div>
    <!-- Başlık ve Puan Alanı -->
    <div class="flex justify-between items-start mb-2 gap-2">
        <h3 class="text-xl font-bold text-gray-900 leading-snug"><%= event.title %></h3>
    
        <!-- Puan Rozeti -->
        <div class="flex items-center gap-1 shrink-0 bg-amber-50 border border-amber-200 text-amber-800 px-2.5 py-1 rounded-md text-xs font-semibold">
        <svg class="w-3.5 h-3.5 text-amber-500 fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        <% if event.rated? %>
            <span><%= event.average_rating %></span>
            <span class="text-amber-600/70 font-normal">(<%= event.ratings.count %>)</span>
        <% else %>
            <span class="text-amber-700 font-normal">Henüz yok</span>
        <% end %>
        </div>
    </div>

    <!-- Detay Bilgileri -->
    <p class="text-sm text-gray-600 mb-1.5">
        <span class="font-semibold text-gray-700">Düzenleyen:</span> <%= event.user&.email || "Bilinmiyor" %> |
        <span class="font-semibold text-gray-700">Kategori:</span> <%= event.category&.name || "Kategorisiz" %>
    </p>
    <p class="text-sm text-gray-600 mb-4">
        <span class="font-semibold text-gray-700">Tarih:</span> <%= event.date_time.strftime("%d.%m.%Y %H:%M") %> |
        <span class="font-semibold text-gray-700">Konum:</span> <%= event.location %>
    </p>
</div>

<div>
    <%= link_to "Detaylar", event_path(event), class: "text-indigo-600 font-semibold hover:text-indigo-800 text-sm inline-flex items-center gap-1" %>
</div>
</div>