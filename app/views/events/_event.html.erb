<div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 flex flex-col justify-between">
<div>
    <div class="flex justify-between items-start mb-2">
    <h3 class="text-xl font-bold text-gray-900"><%= event.title %></h3>
    </div>
    <p class="text-sm text-gray-600 mb-2">
    <span class="font-semibold">Düzenleyen:</span> <%= event.user&.email || "Bilinmiyor" %> | 
    <span class="font-semibold">Kategori:</span> <%= event.category&.name || "Kategorisiz" %>
    </p>
    <p class="text-sm text-gray-600 mb-4">
    <span class="font-semibold">Tarih:</span> <%= event.date_time.strftime("%d.%m.%Y %H:%M") %> | 
    <span class="font-semibold">Konum:</span> <%= event.location %>
    </p>
</div>
<div>
    <%= link_to "Detaylar", event_path(event), class: "text-indigo-600 font-medium hover:underline text-sm" %>
</div>
</div>