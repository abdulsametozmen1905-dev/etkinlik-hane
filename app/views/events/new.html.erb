<div class="max-w-xl mx-auto p-6 bg-white rounded-xl shadow-sm border border-gray-200 mt-6">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">Yeni Etkinlik Oluştur</h1>

  <% if @event.errors.any? %>
    <div class="bg-red-50 text-red-600 p-4 rounded-lg mb-6 border border-red-200">
      <ul class="list-disc list-inside text-sm space-y-1">
        <% @event.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @event, local: true, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :title, "Etkinlik Başlığı", class: "block text-xs font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :title, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :description, "Açıklama", class: "block text-xs font-semibold text-gray-700 mb-1" %>
      <%= f.text_area :description, rows: 4, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :category_id, "Kategori", class: "block text-xs font-semibold text-gray-700 mb-1" %>
      <%= f.collection_select :category_id, Category.all, :id, :name, { prompt: "Kategori Seçin" }, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :date_time, "Tarih ve Saat", class: "block text-xs font-semibold text-gray-700 mb-1" %>
        <%= f.datetime_local_field :date_time, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>
      <div>
        <%= f.label :quota, "Kontenjan", class: "block text-xs font-semibold text-gray-700 mb-1" %>
        <%= f.number_field :quota, min: 1, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>
    </div>

    <div>
      <%= f.label :location, "Konum", class: "block text-xs font-semibold text-gray-700 mb-1" %>
      <%= f.text_field :location, class: "w-full border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div class="pt-2">
      <%= f.submit "Etkinliği Oluştur", class: "w-full bg-indigo-600 text-white font-medium py-2.5 rounded-lg hover:bg-indigo-700 transition cursor-pointer" %>
    </div>
  <% end %>
</div>