<div class="max-w-md mx-auto mt-10 p-6 bg-white rounded-lg shadow-sm border border-gray-200">
  <h1 class="text-2xl font-bold mb-6 text-gray-900">Giriş Yap</h1>

  <%= form_with url: login_path, local: true do |f| %>
    <% if flash[:alert] %>
      <div class="mb-4 p-3 bg-red-50 text-red-700 rounded text-sm">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <div class="mb-4">
      <%= f.label :email, "E-posta", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, class: "w-full px-3 py-2 border rounded-md focus:ring focus:ring-indigo-200" %>
    </div>

    <div class="mb-6">
      <%= f.label :password, "Şifre", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password, class: "w-full px-3 py-2 border rounded-md focus:ring focus:ring-indigo-200" %>
    </div>

    <%= f.submit "Giriş Yap", class: "w-full bg-indigo-600 text-white py-2 rounded-md hover:bg-indigo-700 transition" %>
  <% end %>
</div>