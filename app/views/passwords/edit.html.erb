<div class="max-w-md mx-auto my-12 p-8 bg-white rounded-xl shadow-md border border-gray-100">
  <h2 class="text-2xl font-bold text-gray-800 mb-6">Şifre Değiştir</h2>

  <%= form_with model: @user, url: password_path, method: :patch, local: true, class: "space-y-4" do |f| %>
    <% if @user.errors.any? %>
      <div class="p-3 bg-red-50 text-red-600 text-sm rounded-lg">
        <ul class="list-disc list-inside">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :current_password, "Mevcut Şifreniz", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :current_password, required: true, class: "w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :password, "Yeni Şifre", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password, required: true, class: "w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Yeni Şifre (Tekrar)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password_confirmation, required: true, class: "w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" %>
    </div>

    <div class="flex items-center justify-between pt-2">
      <%= link_to "Vazgeç", root_path, class: "text-sm text-gray-600 hover:underline" %>
      <%= f.submit "Şifreyi Güncelle", class: "bg-indigo-600 hover:bg-indigo-700 text-white font-medium px-5 py-2.5 rounded-lg transition cursor-pointer" %>
    </div>
  <% end %>
</div>